  Logger.log('High-priority desktop: ' + hpDesktopTriggers.length + ' (offset +5min)');
  Logger.log('Active batch triggers: ' + batchTriggers.length);
  Logger.log('');
  
  Logger.log('--- HIGH-PRIORITY RUNS TODAY ---');
  var mobileRunCount = props.getProperty('highPriorityMobileRunCount_' + todayStr) || '0';
  var desktopRunCount = props.getProperty('highPriorityDesktopRunCount_' + todayStr) || '0';
  Logger.log('Mobile: ' + mobileRunCount + '/' + ZEN_CONFIG.highPriorityHours.length);
  Logger.log('Desktop: ' + desktopRunCount + '/' + ZEN_CONFIG.highPriorityHours.length);
  Logger.log('');
  
