function startZenserpAutomation() {
  var props = PropertiesService.getScriptProperties();
  
  if (props.getProperty('zenserpRunning') === 'true') {
    var startTime = props.getProperty('zenserpStartTime');
    if (startTime && startTime.trim() !== '') {
      try {
        var startDate = new Date(startTime);
        if (!isNaN(startDate.getTime())) {
          var hoursElapsed = (new Date() - startDate) / (1000 * 60 * 60);
          if (hoursElapsed > ZEN_CONFIG.maxRunHours) {
            Logger.log('⚠️ Stale run (' + hoursElapsed.toFixed(1) + 'h). Auto-recovering.');
            props.setProperty('zenserpRunning', 'false');
            deleteZenserpBatchTriggers();
          } else {
            Logger.log('Already running. Skipping.');
            return;
          }
        }
      } catch (e) {
        props.setProperty('zenserpRunning', 'false');
      }
    } else {
      props.setProperty('zenserpRunning', 'false');
    }
  }
  
  props.setProperty('zenserpRunning', 'true');
  props.setProperty('zenserpDevice', 'mobile');
  props.setProperty('zenserpBatchIndex', '0');
  props.setProperty('zenserpStartTime', new Date().toISOString());
  props.setProperty('zenserpRetryCount', '0');
  
  deleteZenserpBatchTriggers();
  
  Logger.log('================ STARTING FULL DAILY AUTOMATION ================');
  Logger.log('Time: ' + new Date().toISOString());
  Logger.log('Batch size: 50 keywords (timeout-safe)');
  Logger.log('Total batches: ' + ZEN_BATCH_CONFIG.mobile.length + ' per device');
  Logger.log('Expected timeline: ~' + (ZEN_BATCH_CONFIG.mobile.length * 4) + ' minutes');
  
  ScriptApp.newTrigger(ZEN_TRIGGER_HANDLER)
    .timeBased()
    .after(60 * 1000)
    .create();
}


/**
 * Main batch processor with timeout detection.
 */
function runZenserpAutomation() {
  var executionStart = new Date();
  var props = PropertiesService.getScriptProperties();
  
  if (props.getProperty('zenserpRunning') !== 'true') {
    deleteZenserpBatchTriggers();
    return;
  }
  
  var device = props.getProperty('zenserpDevice') || 'mobile';
  var batchIdx = parseInt(props.getProperty('zenserpBatchIndex') || '0', 10);
  var retryCount = parseInt(props.getProperty('zenserpRetryCount') || '0', 10);
  
  var totalBatches = ZEN_BATCH_CONFIG.mobile.length;
  
  // Completion check - FIXED to check device
  if (device === 'mobile' && batchIdx >= totalBatches) {
    Logger.log('✓ All batches complete!');
    props.setProperty('zenserpRunning', 'false');
    props.setProperty('zenserpCompletedAt', new Date().toISOString());
    deleteZenserpBatchTriggers();
    return;
  }
  
  var batches = ZEN_BATCH_CONFIG[device];
  if (!batches || batchIdx >= batches.length) {
    var nextDevice = (device === 'mobile') ? 'desktop' : 'mobile';
    var nextBatchIdx = (device === 'mobile') ? batchIdx : batchIdx + 1;
    
    props.setProperty('zenserpDevice', nextDevice);
    props.setProperty('zenserpBatchIndex', String(nextBatchIdx));
    props.setProperty('zenserpRetryCount', '0');
    
    Logger.log('Switching to ' + nextDevice + ' batches...');
    scheduleNextBatch();
    return;
  }
  
  var batch = batches[batchIdx];
  
  Logger.log('Processing ' + device.toUpperCase() + ' batch ' + (batchIdx + 1) + '/' + totalBatches + 
    ' (rows ' + batch.start + '-' + batch.end + ')' + 
    (retryCount > 0 ? ' [RETRY #' + retryCount + ']' : ''));
  
  var clearSheet = (batchIdx === 0 && retryCount === 0);
  var batchSuccess = false;
  
  try {
    getZenserpAds(device, batch.start, batch.end, clearSheet, executionStart);
    batchSuccess = true;
    props.setProperty('zenserpRetryCount', '0');
    
} catch (e) {
    Logger.log('⚠️ Batch error: ' + e.message);
    Logger.log('Auto-resuming from batch ' + batchIdx + ' in 2 minutes...');
    props.setProperty('zenserpRunning', 'true');
    scheduleNextBatch(2);
    return;
  }
  
  var nextDevice = (device === 'mobile') ? 'desktop' : 'mobile';
  var nextBatchIdx = (device === 'mobile') ? batchIdx : batchIdx + 1;
  
  props.setProperty('zenserpDevice', nextDevice);
  props.setProperty('zenserpBatchIndex', String(nextBatchIdx));
  props.setProperty('zenserpLastBatch', device + '_' + batchIdx + '_' + (batchSuccess ? 'ok' : 'failed'));
  props.setProperty('zenserpLastBatchTime', new Date().toISOString());
  
  scheduleNextBatch();
}


function scheduleNextBatch(delayMinutes) {
  delayMinutes = delayMinutes || 2;
  
  deleteZenserpBatchTriggers();
  
  try {
    ScriptApp.newTrigger(ZEN_TRIGGER_HANDLER)
      .timeBased()
      .after(delayMinutes * 60 * 1000)
      .create();
      
  } catch (e) {
    Logger.log('⚠️ Trigger creation failed: ' + e.message);
    Utilities.sleep(5000);
    
    try {
      ScriptApp.newTrigger(ZEN_TRIGGER_HANDLER)
        .timeBased()
        .after((delayMinutes + 1) * 60 * 1000)
        .create();
      Logger.log('✓ Trigger created on retry');
    } catch (e2) {
      Logger.log('✗ Trigger creation failed again: ' + e2.message);
      var props = PropertiesService.getScriptProperties();
      props.setProperty('zenserpTriggerFailed', new Date().toISOString());
    }
  }
}


/**
 * Core fetch function with TIMEOUT DETECTION.
 */
function getZenserpAds(device, startRow, endRow, clearSheet, executionStart) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var inputSheet = ss.getSheetByName(ZEN_CONFIG.inputSheetName);
  
  var outputSheetName = device === 'mobile' 
    ? ZEN_CONFIG.outputSheets.mobile 
    : ZEN_CONFIG.outputSheets.desktop;
  
  var outputSheet = ss.getSheetByName(outputSheetName);
  if (!outputSheet) {
    outputSheet = ss.insertSheet(outputSheetName);
  }
  
  if (!inputSheet) {
    throw new Error('Input sheet not found.');
  }
  
  var lock = LockService.getScriptLock();
  
  if (clearSheet) {
    var header = ['Timestamp', 'Keyword', 'Ad Type', 'Ad Position',
                  'Ad Title', 'Displayed Link', 'Ad Link', 'Ad Snippet'];
    acquireLockAndWrite(lock, outputSheet, [header], true);
  }
  
  var lastInputRow = inputSheet.getLastRow();
  if (startRow > lastInputRow) return;
  
  var actualEndRow = Math.min(endRow, lastInputRow);
  var numRows = actualEndRow - startRow + 1;
  if (numRows <= 0) return;
  
  var keywords = inputSheet
    .getRange(startRow, 1, numRows, 1)
    .getValues()
    .flat()
    .filter(String);
  
  if (keywords.length === 0) return;
  
  var rows = [];
  var rate429Count = 0;
  
  for (var i = 0; i < keywords.length; i++) {
    var keyword = keywords[i];
    var ts = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd HH:mm:ss');
    
    // TIMEOUT CHECK - stop if approaching limit
    var elapsedMs = new Date() - executionStart;
    if (elapsedMs > ZEN_CONFIG.maxExecutionTimeMs) {
      Logger.log('⚠️ Timeout: ' + (elapsedMs / 1000).toFixed(1) + 's elapsed. Stopping at keyword ' + (i + 1) + '/' + keywords.length);
      if (rate429Count >= 3) {
        throw new Error('Timeout + rate limited. Will retry.');
      }
      break;
    }
    
    try {
      var url = buildZenserpUrl(keyword, device);
      var response = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
      var code = response.getResponseCode();
      
      if (code === 429) {
        rate429Count++;
        rows.push([ts, keyword, '', '', 'Rate Limited (429)', '', '', '']);
        
        if (rate429Count >= 3) {
          throw new Error('Batch rate limited (429).');
        }
        continue;
      }
      
      if (code !== 200) {
        rows.push([ts, keyword, '', '', 'HTTP ' + code, '', '', '']);
        continue;
      }
      
      var data = JSON.parse(response.getContentText());
      var found = 0;
      
      if (data.ads) {
        ['top', 'bottom'].forEach(function(pos) {
          (data.ads[pos] || []).forEach(function(ad, idx) {
            found++;
            rows.push([
              ts, keyword, pos + '_ads', ad.position || (idx + 1),
              ad.title || '', ad.displayed_link || '',
              ad.url || '', ad.snippet || ad.description || ''
            ]);
          });
        });
      }
      
      if (data.paid) {
        Object.keys(data.paid).forEach(function(k) {
          var ad = data.paid[k];
          found++;
          rows.push([
            ts, keyword, 'paid', k,
            ad.title || '', ad.visurl || '',
            ad.destinationUrl || ad.trackingUrl || '',
            ad.description || ''
          ]);
        });
      }
      
      if (found === 0) {
        rows.push([ts, keyword, '', '', 'No Ads Found', '', '', '']);
      }
      
    } catch (err) {
      if (err.message && err.message.indexOf('429') !== -1) {
        throw err;
      } else if (err.message && (err.message.indexOf('fetch') !== -1 || err.message.indexOf('Connection') !== -1)) {
        rows.push([ts, keyword, '', '', 'Network Error', '', '', '']);
      } else {
        throw err;
      }
    }
    
    if (i < keywords.length - 1) {
      Utilities.sleep(ZEN_CONFIG.delayMs);
    }
  }
  
  if (rows.length > 0) {
    acquireLockAndWrite(lock, outputSheet, rows, false);
  }
  
  if (rate429Count > 0) {
    Logger.log('⚠️ Rate limited ' + rate429Count + ' times');
  }
}


