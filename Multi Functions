function isAutomationHealthy() {
  var triggers = ScriptApp.getProjectTriggers();
  
  var hasDailyTrigger = triggers.some(function(t) { return t.getHandlerFunction() === ZEN_DAILY_STARTER; });
  var hasMobileTriggers = triggers.some(function(t) { return t.getHandlerFunction() === ZEN_HIGH_PRIORITY_HANDLER_MOBILE; });
  var hasDesktopTriggers = triggers.some(function(t) { return t.getHandlerFunction() === ZEN_HIGH_PRIORITY_HANDLER_DESKTOP; });
  
  var healthy = hasDailyTrigger && hasMobileTriggers && hasDesktopTriggers;
  
  Logger.log('Health check: ' + (healthy ? '✓ HEALTHY' : '✗ ISSUES'));
  if (!hasDailyTrigger) Logger.log('  - Missing daily trigger');
  if (!hasMobileTriggers) Logger.log('  - Missing mobile triggers');
  if (!hasDesktopTriggers) Logger.log('  - Missing desktop triggers');
  
  return healthy;
}
